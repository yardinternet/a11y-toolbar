{
	"name": "@yardinternet/a11y-toolbar",
	"version": "0.11.2",
	"author": "Yard | Digital Agency",
	"license": "EPL-1.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yardinternet/a11y-toolbar.git"
	},
	"main": "dist/a11y-toolbar.js",
	"module": "dist/a11y-toolbar.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/a11y-cookie-yes.js"
		},
		"./dist/*": "./dist/*"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com/@yardinternet"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"start": "vite build --watch",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"lint:js": "yard-toolkit lint js -m custom './src/**/*.ts' && pnpm run typecheck",
		"lint:css": "yard-toolkit lint scss -m custom './src/**/*.scss'",
		"format:js": "yard-toolkit format js -m custom './src/**/*.ts'",
		"format:css": "yard-toolkit format scss -m custom './src/**/*.scss'",
		"prepare": "husky"
	},
	"devDependencies": {
		"@yardinternet/eslint-config": "^1.2.12",
		"@yardinternet/prettier-config": "^2.0.11",
		"@yardinternet/stylelint-config": "^1.1.8",
		"@yardinternet/toolkit": "^2.1.12",
		"@yardinternet/ts-config": "^1.1.2",
		"@yardinternet/vite-config": "^1.3.5",
		"deepmerge": "^4.3.1",
		"husky": "^9.1.7",
		"postcss-scss": "^4.0.9",
		"sass": "^1.101.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.5"
	},
	"dependencies": {
		"focus-trap": "^7.4.3",
		"js-cookie": "^3.0.5"
	}
}
